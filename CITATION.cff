cff-version: 1.2.0
message: "If you use vphilox in your research, please cite it as below."
title: "vphilox: SIMD-Accelerated Counter-Based Pseudo-Random Number Generation for Parallel CPU Systems"
abstract: >-
  A header-only, zero-dependency C++20 implementation of the Philox4x32-10
  counter-based pseudorandom number generator, vectorized by interleaving
  independent counter streams across AVX2, AVX-512, and ARM NEON registers.
  Pairs multi-stream SIMD interleaving with division-free IEEE-754 mantissa
  injection for floating-point conversion, and satisfies
  std::uniform_random_bit_generator.
type: software
authors:
  - family-names: Sinha
    given-names: Parth
    email: sinhaparth555@gmail.com
    orcid: "https://orcid.org/0009-0002-3120-9301"
    affiliation: "Independent Researcher, Oxford, United Kingdom"
repository-code: "https://github.com/sinhaparth5/vphilox"
license:
  - Apache-2.0
  - MIT
version: 2026.08.1
date-released: "2026-08-26"
doi: "10.5281/zenodo.22103483"
keywords:
  - pseudorandom number generation
  - counter-based PRNG
  - Philox
  - SIMD
  - AVX2
  - AVX-512
  - ARM NEON
  - high-performance computing
  - reproducibility
  - C++20
# Two Zenodo DOIs, deliberately. `doi` above is this exact version, which is what
# paper/vphilox.tex cites when it says "the release measured here", and it agrees
# with the `version` and `date-released` in this file. The concept DOI below
# covers every version and always resolves to the newest, so it is the one to use
# when the citation is to vphilox rather than to 2026.08.1. Bump `doi` on each
# release; the concept DOI never changes.
#
# TODO(phase-5): one edit left. Add a `preferred-citation:` block once the paper
# is posted and has an identifier. That was going to be a TechRxiv DOI; TechRxiv
# closed to submissions during a platform migration, so it will be the arXiv ID.
# See docs/publishing-guide.md.
identifiers:
  - type: doi
    value: "10.5281/zenodo.22103482"
    description: "Concept DOI, resolving to the latest released version"
references:
  - type: conference-paper
    title: "Parallel Random Numbers: As Easy as 1, 2, 3"
    authors:
      - family-names: Salmon
        given-names: John K.
      - family-names: Moraes
        given-names: Mark A.
      - family-names: Dror
        given-names: Ron O.
      - family-names: Shaw
        given-names: David E.
    collection-title: "Proceedings of the International Conference for High Performance Computing, Networking, Storage and Analysis (SC'11)"
    year: 2011
    doi: "10.1145/2063384.2063405"
