# vphilox artifacts
# Benchmark JSON and PractRand logs are generated; the curated results that
# back the paper live in docs/benchmarks/ and docs/statistical/ and are tracked.
*.practrand.log
bench_results_*.json

# Temporary directory produced by `gcloud compute scp`; curated files are
# copied into results/ before committing.
avx512-results/

# Python bytecode from the benchmark publishing script
__pycache__/
*.pyc
